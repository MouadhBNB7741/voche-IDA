PROJECT_NAME="VOCHE App"
PORT=8000
DATABASE_URL="postgresql://postgres:your_postgres_password@your-db-host:5432/voce"
REDIS_URL="redis://your-redis-host:6379"
SECRET_KEY="your_super_secret_key_must_be_at_least_32_bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=60
SMTP_USER="your_email@example.com"
SMTP_PASSWORD="your_smtp_app_password"

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="voce"
POSTGRES_PORT=5432
REDIS_PORT=6379

FRONTEND_VAR="https://www.voche.org/"
# Private file storage (doctor licences). Use s3 in production: Amazon S3, Cloudflare R2 or Supabase Storage
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Google sign-in: OAuth Client ID (public, same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
